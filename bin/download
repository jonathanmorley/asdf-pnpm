#!/usr/bin/env bash
# shellcheck shell=bash

set -Eeuo pipefail

if [[ ${ASDF_INSTALL_TYPE:-version} == 'ref' ]]; then
  echo >&2 "⛔ This plugin does not support installing by ref."
  exit 1
fi

FALLBACK_REGISTRY='https://registry.npmjs.org/'

REGISTRY="${NPM_CONFIG_REGISTRY:-$FALLBACK_REGISTRY/}"
if command -v npm 1>/dev/null; then
  REGISTRY=$(npm config get registry --force 2>/dev/null)
fi

mkdir -p "${ASDF_DOWNLOAD_PATH}"

download_and_extract() {
  local reg="$1"
  local tarball_url="${reg%/}/pnpm/-/pnpm-${ASDF_INSTALL_VERSION}.tgz"
  local tmpfile
  tmpfile=$(mktemp)
  local http_code

  echo "Downloading pnpm v${ASDF_INSTALL_VERSION} from ${tarball_url}"
  http_code=$(curl --silent --write-out "%{http_code}" --location "${tarball_url}" -o "$tmpfile") || http_code="000"

  if [[ $http_code == "000" ]]; then
    echo >&2 "⛔ Failed to connect to ${tarball_url} (network/TLS error)"
    rm -f "$tmpfile"
    return 1
  elif [[ $http_code != "200" ]]; then
    echo >&2 "⛔ Failed to download from ${tarball_url} (HTTP ${http_code})"
    rm -f "$tmpfile"
    return 1
  fi

  tar xzf "$tmpfile" --strip-components=1 --no-same-owner -C "${ASDF_DOWNLOAD_PATH}"
  rm -f "$tmpfile"
}

# `npm pack` fetches the tarball with npm's own auth/CA/proxy handling, so it
# works against registries that reject anonymous requests (HTTP 401).
download_and_extract_npm() {
  local tmpdir tarball
  tmpdir=$(mktemp -d)
  echo "Downloading pnpm v${ASDF_INSTALL_VERSION} via npm pack (registry ${REGISTRY})"
  if ! tarball=$(npm pack "pnpm@${ASDF_INSTALL_VERSION}" --pack-destination "$tmpdir" --silent 2>&1); then
    echo >&2 "⛔ npm pack failed: $(echo "$tarball" | head -2)"
    rm -rf "$tmpdir"
    return 1
  fi
  tar xzf "${tmpdir}/$(echo "$tarball" | tail -1)" --strip-components=1 --no-same-owner -C "${ASDF_DOWNLOAD_PATH}"
  rm -rf "$tmpdir"
}

if command -v npm 1>/dev/null && download_and_extract_npm; then
  exit 0
fi

# Try configured registry first, fall back to default if different and first attempt fails
if ! download_and_extract "$REGISTRY" 2>/dev/null; then
  if [[ ${REGISTRY%/} != "${FALLBACK_REGISTRY%/}" ]]; then
    echo "Download from configured registry failed, trying fallback registry..."
    download_and_extract "$FALLBACK_REGISTRY"
  else
    echo "Download from registry failed."
    exit 1
  fi
fi
